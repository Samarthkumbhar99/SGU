# SupplyShield AI — Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# Server
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# MongoDB Atlas
# ============================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/supplychield?retryWrites=true&w=majority

# ============================================================
# JWT
# ============================================================
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ============================================================
# Google OAuth 2.0
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ============================================================
# Frontend URL (for CORS and OAuth redirect)
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# ML Service (FastAPI)
# ============================================================
ML_SERVICE_URL=http://localhost:8000
