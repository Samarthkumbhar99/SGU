# SupplyShield AI — ML Service Environment Variables
# Copy to .env and adjust as necessary for your local environment

# Service Environment
APP_ENV=development
DEBUG=false

# Server Bind Configuration
HOST=127.0.0.1
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Dataset Directory Path (defaults to ../data/demo if relative)
DATASET_DIR=../data/demo
